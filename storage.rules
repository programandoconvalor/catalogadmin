
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================
    // AUTENTICACIÓN Y TENANT
    // =========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userTenantDoc(uid) {
      return /databases/(default)/documents/userTenants/$(uid);
    }

    function tenantAssignment(tenantId) {
      return isSignedIn()
        && firestore.get(userTenantDoc(request.auth.uid)).data.tenantId == tenantId
        && firestore.get(userTenantDoc(request.auth.uid)).data.status == 'active';
    }

    function canReadTenantFiles(tenantId) {
      return tenantAssignment(tenantId)
        && firestore.get(userTenantDoc(request.auth.uid)).data.role
          in ['owner', 'admin', 'editor', 'viewer'];
    }

    function canWriteTenantFiles(tenantId) {
      return tenantAssignment(tenantId)
        && firestore.get(userTenantDoc(request.auth.uid)).data.role
          in ['owner', 'admin', 'editor'];
    }

    // =========================================
    // VALIDACIÓN DE IMÁGENES
    // =========================================

    function validImage(maxSize) {
      return request.resource != null
        && request.resource.size <= maxSize
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // =========================================
    // PRODUCTOS
    // tenants/{tenantId}/normal/products/images/{fileName}
    // =========================================

    match /tenants/{tenantId}/{catalogId}/products/images/{fileName} {

      allow read: if catalogId == 'normal'
        && canReadTenantFiles(tenantId);

      allow create, update: if catalogId == 'normal'
        && canWriteTenantFiles(tenantId)
        && validImage(5 * 1024 * 1024);

      allow delete: if catalogId == 'normal'
        && canWriteTenantFiles(tenantId);
    }

    // =========================================
    // LOGO DE LA FLORERÍA
    // tenants/{tenantId}/branding/logo/{fileName}
    // Máximo 2 MB
    // =========================================

    match /tenants/{tenantId}/branding/logo/{fileName} {

      allow read: if canReadTenantFiles(tenantId);

      allow create, update: if canWriteTenantFiles(tenantId)
        && validImage(2 * 1024 * 1024);

      allow delete: if canWriteTenantFiles(tenantId);
    }

    // =========================================
    // FAVICON DE LA FLORERÍA
    // tenants/{tenantId}/branding/favicon/{fileName}
    // Máximo 1 MB
    // =========================================

    match /tenants/{tenantId}/branding/favicon/{fileName} {

      allow read: if canReadTenantFiles(tenantId);

      allow create, update: if canWriteTenantFiles(tenantId)
        && validImage(1 * 1024 * 1024);

      allow delete: if canWriteTenantFiles(tenantId);
    }

  }
}
