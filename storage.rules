rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userTenantDoc(uid) {
      return /databases/(default)/documents/userTenants/$(uid);
    }

    // Read one Firestore document for the current user.
    // This requires cross-service Rules permissions to be enabled in Firebase.
    function tenantAssignment(tenantId) {
      return isSignedIn()
        && firestore.get(userTenantDoc(request.auth.uid)).data.tenantId == tenantId
        && firestore.get(userTenantDoc(request.auth.uid)).data.status == 'active';
    }

    function canReadTenantFiles(tenantId) {
      return tenantAssignment(tenantId)
        && firestore.get(userTenantDoc(request.auth.uid)).data.role
          in ['owner', 'admin', 'editor', 'viewer'];
    }

    function canWriteProductImages(tenantId) {
      return tenantAssignment(tenantId)
        && firestore.get(userTenantDoc(request.auth.uid)).data.role
          in ['owner', 'admin', 'editor'];
    }

    function validProductImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Exact path generated by StorageService:
    // tenants/{tenantId}/{normal|vip}/products/images/{fileName}
    match /tenants/{tenantId}/{catalogId}/products/images/{fileName} {
      allow read: if catalogId in ['normal', 'vip']
        && canReadTenantFiles(tenantId);

      allow create, update: if catalogId in ['normal', 'vip']
        && canWriteProductImages(tenantId)
        && validProductImage();

      allow delete: if catalogId in ['normal', 'vip']
        && canWriteProductImages(tenantId);
    }
  }
}
