# =========================================================
# Local environment files and secrets
# =========================================================
.env
.env.*
!.env.example
*.local

# Angular environment overrides (local only)
# Keep environment.ts and environment.development.ts tracked
# until Firebase configuration has been migrated safely.
# Do not ignore the existing Firebase environment files yet.

# =========================================================
# Firebase Admin SDK and service-account credentials
# =========================================================
serviceAccount*.json
firebase-adminsdk*.json
*-service-account*.json
*service-account-key*.json

# =========================================================
# Private keys and certificates
# =========================================================
*.pem
*.key
*.p12
*.pfx

